# Переменные окружения ProfiStatus (скопируйте в .env)
# Никаких секретов в PUBLIC_* — они попадают в клиентский бандл.

# Куда слать заявки (Formspree). Получить: formspree.io → New Form → вставить URL.
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/XXXXYYYY

# PostHog (A/B-тесты, воронки). Пусто = события только в console.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Яндекс.Метрика (ID счётчика). Пусто = не подключается.
PUBLIC_YANDEX_METRICA_ID=

# Канонический URL сайта
SITE=https://superpirov.github.io/profistatus
