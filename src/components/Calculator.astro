---
// Калькулятор экономии для hero-блока: показывает выгоду самозанятости vs. «серая» схема.
// Чистый клиентский компонент, считается локально.
---
<section aria-label="Калькулятор экономии" class="rounded-2xl border bg-white p-6 shadow-sm">
  <h2 class="text-xl font-semibold">Сколько вы сохраните легально?</h2>
  <label class="mt-4 grid gap-1 text-sm">
    Доход в месяц, ₽
    <input id="calc-income" type="number" min="0" value="100000" class="rounded-lg border px-3 py-2" />
  </label>
  <div class="mt-3 grid grid-cols-2 gap-3 text-sm">
    <div class="rounded-xl bg-slate-50 p-3">
      <p class="text-slate-500">Налог самозанятого (4–6%)</p>
      <p id="calc-tax" class="text-lg font-bold">4 000 ₽</p>
    </div>
    <div class="rounded-xl bg-indigo-50 p-3">
      <p class="text-slate-500">Риски «в серую» (штрафы до)</p>
      <p class="text-lg font-bold">20 000 ₽</p>
    </div>
  </div>
  <p class="mt-2 text-xs text-slate-500">Ставка 4% — для физлиц, 6% — для юрлиц. Расчёт ориентировочный.</p>
</section>

<script is:inline>
  const income = document.getElementById('calc-income');
  const tax = document.getElementById('calc-tax');
  // По умолчанию считаем по ставке 4%; переключатель A/B — через PostHog feature flag позже.
  function recalc() {
    const v = Number(income?.value ?? 0);
    if (tax) tax.textContent = Math.round(v * 0.04).toLocaleString('ru-RU') + ' ₽';
  }
  income?.addEventListener('input', recalc);
  recalc();
</script>
