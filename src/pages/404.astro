---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Страница не найдена" description="Ошибка 404.">
  <div class="mx-auto max-w-xl px-4 py-16 text-center">
    <h1 class="text-4xl font-bold">404</h1>
    <p class="mt-2 text-slate-600">Такой страницы нет. Вернитесь на главную.</p>
    <a href={import.meta.env.BASE_URL} class="mt-4 inline-block rounded-lg bg-indigo-600 px-4 py-2 text-white">На главную</a>
  </div>
</BaseLayout>
