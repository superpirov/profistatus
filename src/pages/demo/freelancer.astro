---
// Демо-страница переехала в рабочий кабинет: мгновенный редирект для старых ссылок.
import { link } from '@/lib/site';
const target = link('app/');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Переезд в кабинет — ProfiStatus</title>
  </head>
  <body>
    <p>Раздел переехал в <a href={target}>рабочий кабинет</a>.</p>
  </body>
</html>
