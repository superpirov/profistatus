---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Статический пререндер 3 демо-статей (SSG). При росте — вынести в content collections.
export function getStaticPaths() {
  return [
    { params: { slug: 'samozanyatost-2026' } },
    { params: { slug: 'dogovor-s-samozanyatym' } },
    { params: { slug: 'keys-vektor' } },
  ];
}
const { slug } = Astro.params;
---
<BaseLayout title={`Статья: ${slug}`} description="Статья блога ProfiStatus." path={`/blog/${slug}`}>
  <article class="mx-auto max-w-3xl px-4 pt-10">
    <h1 class="text-3xl font-bold">Статья: {slug}</h1>
    <p class="mt-4 text-slate-600 text-sm">SEO-контент MVP: полный текст появится после запуска. Сейчас страница-заглушка подтверждает маршрутизацию и canonical URL.</p>
    <p class="mt-4 text-sm">Вернуться к <a class="underline" href={`${import.meta.env.BASE_URL}blog`}>списку статей</a>.</p>
  </article>
</BaseLayout>
