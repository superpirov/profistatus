---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Мои услуги" description="Каталог услуг самозанятого для быстрого выставления чеков и счетов." path="/app/services">
  <div class="mx-auto max-w-6xl px-4 pt-8">
    <h1 class="text-3xl font-bold">Мои услуги</h1>
    <p class="mt-1 text-sm text-slate-600">Добавьте услуги один раз — потом выбирайте их в чеках и счетах, сумма подставится автоматически.</p>

    <div class="mt-6 grid gap-6 md:grid-cols-[320px_1fr] items-start">
      <form id="svc-form" class="rounded-2xl border bg-white p-5 grid gap-3 text-sm" novalidate>
        <h2 class="font-semibold text-base">Новая услуга</h2>
        <label class="grid gap-1">Название
          <input id="svc-name" class="rounded-lg border px-3 py-2" placeholder="Например: Консультация" />
        </label>
        <label class="grid gap-1">Цена по умолчанию, ₽ (необязательно)
          <input id="svc-price" type="number" min="0" class="rounded-lg border px-3 py-2" placeholder="3000" />
        </label>
        <ul id="svc-errors" class="text-red-700 grid gap-1" aria-live="polite"></ul>
        <button class="rounded-lg bg-indigo-600 px-4 py-2.5 text-white font-medium hover:bg-indigo-700">Добавить</button>
      </form>

      <section class="rounded-2xl border bg-white p-5" aria-label="Список услуг">
        <h2 class="font-semibold text-base">Каталог</h2>
        <ul id="svc-list" class="mt-3 grid gap-2 text-sm"></ul>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { addService, fmtMoney, getServices, removeService } from '@/lib/store';

  const list = document.getElementById('svc-list');

  function render() {
    const all = getServices();
    list.innerHTML = all.map((s) => `<li class="rounded-xl border p-3 flex justify-between gap-2">
        <span><strong>${s.name}</strong> ${s.defaultPrice !== null ? `<span class="text-slate-600">· ${fmtMoney(s.defaultPrice)}</span>` : '<span class="text-slate-500">· цена вручную</span>'}</span>
        <button data-del="${s.id}" class="rounded-lg border px-3 py-1 text-red-700 hover:bg-red-50">Удалить</button></li>`).join('') || '<li class="text-slate-500">Пока пусто.</li>';
  }

  document.getElementById('svc-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('svc-name').value ?? '';
    const priceRaw = document.getElementById('svc-price').value ?? '';
    if (!name.trim()) {
      document.getElementById('svc-errors').innerHTML = '<li>• Укажите название услуги.</li>';
      return;
    }
    document.getElementById('svc-errors').innerHTML = '';
    addService(name, priceRaw ? Number(priceRaw) : null);
    e.target.reset();
    render();
  });

  list.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (btn?.dataset.del) { removeService(btn.dataset.del); render(); }
  });

  render();
</script>
