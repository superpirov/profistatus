---
import '../styles/global.css';
import { env } from '@/lib/env';
import { basePath, canonicalUrl, link } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
// Все ссылки строим через link()/canonicalUrl() — BASE_URL без слэша даёт 404 (см. src/lib/site.ts)
const canonical = canonicalUrl(path);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — ProfiStatus</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href={link('favicon.svg')} />
    <!-- Яндекс.Метрика и PostHog подключаются только при заданных ключах (см. .env.example) -->
    {env.yandexMetricaId && (
      <script is:inline define:vars={{ id: env.yandexMetricaId }}>
        console.debug('Yandex Metrica id:', id);
      </script>
    )}
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:p-2 focus:bg-white">
      Перейти к содержимому
    </a>
    <header class="border-b bg-white/80 backdrop-blur sticky top-0 z-40">
      <nav class="mx-auto max-w-6xl flex items-center gap-4 px-4 py-3" aria-label="Основная навигация">
        <a href={basePath} class="font-bold text-lg text-indigo-700">ProfiStatus</a>
        <a href={link('freelancers')} class="hidden sm:inline text-sm hover:underline">Исполнителям</a>
        <a href={link('business')} class="hidden sm:inline text-sm hover:underline">Бизнесу</a>
        <a href={link('how-it-works')} class="hidden sm:inline text-sm hover:underline">Как это работает</a>
        <a href={link('blog')} class="hidden sm:inline text-sm hover:underline">Блог</a>
        <a href={link('app')} class="ml-auto text-sm rounded-lg bg-indigo-600 px-3 py-2 text-white hover:bg-indigo-700">
          Кабинет
        </a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="mt-16 border-t bg-white">
      <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-slate-600 flex flex-col sm:flex-row gap-4 justify-between">
        <p>© 2026 ProfiStatus · MVP-прототип для валидации спроса</p>
        <nav class="flex gap-4" aria-label="Нижняя навигация">
          <a href={link('legal')} class="hover:underline">Правовая информация</a>
          <a href={link('blog')} class="hover:underline">Блог</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
